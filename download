:root {
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  color: #172033;
  background: #f5f7fb;
  line-height: 1.6;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
}

main {
  width: min(980px, calc(100% - 32px));
  margin: 40px auto 80px;
}

header {
  margin-bottom: 24px;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 5vw, 3.5rem);
}

h2 {
  margin-top: 0;
  font-size: 1.15rem;
}

.eyebrow {
  margin-bottom: 4px;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.card,
.notice {
  margin: 16px 0;
  padding: 22px;
  background: white;
  border: 1px solid #dce2ec;
  border-radius: 16px;
}

.notice {
  border-left-width: 6px;
}

.grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 24px;
}

.form-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 20px;
}

label {
  display: grid;
  gap: 6px;
  font-weight: 650;
}

input,
select,
button {
  width: 100%;
  padding: 10px 12px;
  font: inherit;
  background: white;
  border: 1px solid #bcc6d5;
  border-radius: 10px;
}

button {
  width: auto;
  cursor: pointer;
  font-weight: 700;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.status {
  min-height: 1.6em;
  margin-bottom: 0;
  white-space: pre-wrap;
}

.hint {
  color: #5e6a7d;
  font-size: 0.9rem;
}

.download-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

@media (max-width: 760px) {
  .grid,
  .form-grid {
    grid-template-columns: 1fr;
  }
}
